# Copy to /etc/chordarr/chordarr.env (chmod 640, owned by root:chordarr).
# Every setting is optional; see README for the full list.
CHORDARR_PORT=8585
CHORDARR_DATA_DIR=/var/lib/chordarr
CHORDARR_ROOT_FOLDER=/data/media/music
# CHORDARR_UI_PASSWORD=change-me        # leave empty when a reverse proxy handles login
# CHORDARR_URL_BASE=/chordarr           # when served under a sub-path
# CHORDARR_REFRESH_INTERVAL_HOURS=12
# CHORDARR_LOG_LEVEL=info
# Acquisition (0.2). Nothing is grabbed until auto_grab is on (also switchable in Settings → Indexers).
# CHORDARR_AUTO_GRAB=false
# CHORDARR_QUALITY_PROFILE=lossless     # lossless | high | any
# CHORDARR_IMPORT_MODE=auto             # auto (hard-link torrents, move usenet) | hardlink | copy | move
# CHORDARR_TRACK_FORMAT={nn} - {title}
# CHORDARR_RSS_INTERVAL_MINUTES=30
# CHORDARR_SEARCH_INTERVAL_HOURS=6
# CHORDARR_QUEUE_POLL_SECONDS=60
