# Copy to /etc/chordarr/chordarr.env (chmod 640, owned by root:chordarr).
# Every setting is optional; see README for the full list.
CHORDARR_PORT=8688
CHORDARR_DATA_DIR=/var/lib/chordarr
CHORDARR_ROOT_FOLDER=/data/media/music
# CHORDARR_UI_PASSWORD=change-me        # leave empty when a reverse proxy handles login
# CHORDARR_URL_BASE=/chordarr           # when served under a sub-path
# CHORDARR_REFRESH_INTERVAL_HOURS=12
# CHORDARR_LOG_LEVEL=info
